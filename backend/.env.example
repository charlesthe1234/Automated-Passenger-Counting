CAMERA_URL=rtsp://username:password@192.168.50.192:554/Streaming/Channels/101
CAMERA_URLS=cam_1=rtsp://username:password@192.168.50.192:554/Streaming/Channels/101,cam_2=rtsp://username:password@192.168.50.81:554/Streaming/Channels/101
PRIMARY_CAMERA_ID=cam_1
CAMERA_RECONNECT_SECONDS=5
CAMERA_JPEG_QUALITY=80
SQLITE_DB_PATH=./passenger_monitoring.db
OBSERVATION_UPLOAD_DIR=./uploads/observations
EVACUEE_UPLOAD_DIR=./uploads/evacuees
FRONTEND_DIST_DIR=../frontend/dist
ZONE_CAPACITIES_JSON={"cam_1":150,"cam_2":150}
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_METRICS=cag/metrics
MQTT_TOPIC_TACTICAL=cag/tactical
MQTT_TOPIC_ALERTS=cag/alerts
MQTT_METRIC_LOG_INTERVAL_SECONDS=1

# Dashboard-controlled CV worker. Camera credentials stay in CAMERA_URLS
# above and are never sent to the browser or placed in process arguments.
CV_ENABLED=true
CV_WORKER_PYTHON=../.venv-cv-linux/bin/python
CV_WORKER_SCRIPT=../edge_tracker/cv_worker.py
CV_WORKER_LOG=../LogEvidance/cv_service.jsonl
CV_RUN_ID=field_test_001
CV_CAMERA_MODE=both
CV_USE_MEDIAPIPE=true
CV_USE_REID=true
CV_ENABLE_MIVOLO=true
CV_USE_MQTT=true
CV_YOLO_DEVICE_1=0
CV_YOLO_DEVICE_2=1
CV_REID_DEVICE=cuda:1
CV_YOLO_MODEL=yolo26m.pt
CV_MEDIAPIPE_MODEL=pose_landmarker_full.task
# auto, cpu, gpu, gpu:0, or gpu:1
CV_MEDIAPIPE_DELEGATE=auto
CV_REID_CHECKPOINT=transreid_msmt17.pth
CV_REID_ROLE_CHECKPOINT=evacuation_mobilenet_v1.pth
CV_HOMOGRAPHY_1=homography_matrix.json
CV_HOMOGRAPHY_2=homography_matrix_2.json
CV_MAP_SIZE_CM=480
CV_MAP_GRID_COLUMNS=5
CV_MAP_GRID_ROWS=5
CV_FUSION_DISTANCE_CM=50
CV_CROSS_CAMERA_MAX_SKEW_SECONDS=0.35
CV_REID_DISTANCE_THRESHOLD=0.30
CV_REID_API_URL=http://localhost:8000

# Legacy operator token. The normal dashboard workflow no longer uses this:
# CV Start/Stop is authorized by an admin login plus CSRF. Leave the
# compatibility path disabled unless an approved script still needs it, and
# never expose the token to the browser.
CV_CONTROL_ALLOW_LAN=false
CV_CONTROL_TOKEN=
CV_CONTROL_LEGACY_TOKEN_ENABLED=false

# --- Dashboard authentication ----------------------------------------------
# APP_ENV=demo plus ALLOW_DEMO_ACCOUNT_SEEDING=true are BOTH required before
# `python -m auth.cli seed-demo-users --confirm-insecure-demo` will run. Use
# production for any real deployment.
APP_ENV=production
ALLOW_DEMO_ACCOUNT_SEEDING=false

# Password login from a non-loopback client is refused over plain HTTP unless
# this is true. It is intended ONLY for a controlled demonstration LAN with no
# HTTPS yet; credentials and session cookies are not confidential when enabled.
# Set it back to false once TLS is configured.
AUTH_ALLOW_INSECURE_HTTP=false

# Session lifetimes. Idle expiry ends an unused session; the absolute timeout
# ends every session regardless of activity.
AUTH_SESSION_IDLE_MINUTES=720
AUTH_SESSION_ABSOLUTE_HOURS=24

# Only enable when FastAPI genuinely sits behind a trusted reverse proxy.
# Otherwise a LAN client could forge X-Forwarded-For/Proto to fake loopback.
AUTH_TRUST_PROXY_HEADERS=false

# --- Run/session management -------------------------------------------------
# Compatibility default for the initial Run Manager release. The team still
# launches the CV pipeline from a terminal for debugging, and that data must
# keep arriving; it is recorded as an external/unmanaged run, never as a
# completed managed run. Startup logs a warning while this is true.
# Set it to false only once every launch path starts through the dashboard.
ALLOW_UNMANAGED_RUN_INGESTION=true

# How recently an external run must have received data to count as "active".
# A recently active external run cannot be deleted; stop the external CV
# process and wait for this window to pass first.
EXTERNAL_RUN_ACTIVE_WINDOW_SECONDS=10

# Run/CV reconciliation. A run never sits in a transitional state forever:
# exceeding the start timeout fails it, exceeding the stop timeout marks it
# interrupted.
RUN_START_TIMEOUT_SECONDS=120
RUN_STOP_TIMEOUT_SECONDS=30
RUN_RECONCILE_INTERVAL_SECONDS=2

# Run-scoped writes take the SQLite write lock with BEGIN IMMEDIATE so a late
# payload cannot recreate a run that is being deleted. These bound how long a
# writer waits for a busy database, and how many times pure lock contention is
# retried. Integrity errors are never retried.
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_WRITE_LOCK_RETRY_COUNT=3

# --- CV service authentication ----------------------------------------------
# One long random secret for the deployment. FastAPI validates it; the CV
# worker sends it as X-CV-Service-Token when uploading identity metadata and
# gallery evidence. On this single-machine deployment the managed worker
# inherits it from this file through the backend. Generate with:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the real value, place it in a command line, or expose it to React.
CV_SERVICE_TOKEN=
